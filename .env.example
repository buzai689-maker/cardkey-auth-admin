# Copy to .env and adjust. All values are optional (sane defaults exist).

APP_NAME=卡密授权管理后台

# Session signing key — set to a random 64-hex string in production.
SECRET_KEY=change-this-to-a-random-64-char-hex

# SQLite (default) or MySQL, e.g. mysql+pymysql://user:pass@127.0.0.1:3306/kmauth
DATABASE_URL=sqlite:///data/app.db

DEBUG=1

# First-run bootstrap super admin (created only when the admins table is empty).
DEFAULT_ADMIN=admin
DEFAULT_ADMIN_PWD=admin888
